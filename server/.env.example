# 서버 포트
PORT=3000

# 실행 환경 (development | production)
NODE_ENV=development

# CORS 허용 도메인
# 개발: Vite dev server
# 운영: Nginx를 통해 서빙되므로 동일 origin (http://localhost)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL 연결 문자열
# 개발 환경: docker-compose.dev.yml 로 DB 컨테이너 실행 후 사용
DATABASE_URL=postgresql://rwr_user:rwr_password@localhost:5432/rwr_db

# 운영 환경: docker-compose.yml 내 서비스명 'db' 사용 (아래 주석 해제)
# DATABASE_URL=postgresql://rwr_user:rwr_password@db:5432/rwr_db
