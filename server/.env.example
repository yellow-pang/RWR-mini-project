# 서버 포트
PORT=3000

# 실행 환경 (development | production)
NODE_ENV=development

# CORS 허용 도메인
# 개발: Vite dev server
# 운영: Nginx를 통해 서빙되므로 동일 origin (http://localhost)
CORS_ORIGIN=http://localhost:5173

# JSON 요청 body 제한
JSON_BODY_LIMIT=4kb

# API 요청 제한
# 일반 API: 15분당 300회
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# 외부 API 의존 경로(/api/routes, /api/locations): 5분당 60회
EXTERNAL_API_RATE_LIMIT_WINDOW_MS=300000
EXTERNAL_API_RATE_LIMIT_MAX=60

# 외부 API timeout (밀리초)
ORS_TIMEOUT_MS=8000
KAKAO_TIMEOUT_MS=5000
KAKAO_POI_TIMEOUT_MS=5000

# ORS Round Trip API 키
# https://account.heigit.org/manage/key 에서 basic token 확인
ORS_API_KEY=

# 카카오 Local REST API 키
# 주소→좌표, 좌표→주소 변환 서버 프록시에서 사용
KAKAO_REST_API_KEY=

# PostgreSQL 연결 문자열
# 개발 환경: docker-compose.dev.yml 로 DB 컨테이너 실행 후 사용
DATABASE_URL=postgresql://rwr_user:rwr_password@localhost:5432/rwr_db

# 운영 환경: docker-compose.yml 내 서비스명 'db' 사용 (아래 주석 해제)
# DATABASE_URL=postgresql://rwr_user:rwr_password@db:5432/rwr_db
