# ================================================================
# RWR: Run Walk Random — 통합 환경변수 예제
# ================================================================
# 이 파일을 복사해 .env 를 만들고 실제 값으로 채워주세요.
#   cp .env.example .env
#
# .env 는 .gitignore 에 포함되어 있으므로 절대 커밋되지 않습니다.
# GitHub Actions 배포 시에는 .env 파일 전체 내용을 GitHub Secret 'ENV_FILE' 하나에
# 붙여넣으면 됩니다. (변수가 추가·변경되어도 deploy.yml 수정 불필요)
# ================================================================

# ── Nginx ──────────────────────────────────────────────────────
# VM에서 외부로 노출할 포트 (health-center가 3000/8080을 사용 중이므로 8090 권장)
NGINX_PORT=8090

# ── Express Server ─────────────────────────────────────────────
NODE_ENV=production

# CORS 허용 도메인 (Cloudflare Tunnel 서브도메인으로 변경)
CORS_ORIGIN=https://rwr.yourdomain.com

# ORS Round Trip API 키 (서버 프록시에서만 사용)
# https://account.heigit.org/manage/key 에서 basic token 확인
ORS_API_KEY=

# ── PostgreSQL ─────────────────────────────────────────────────
# ⚠️ 비밀번호는 영문+숫자 조합 권장 ($, & 등 특수문자는 shell 파싱 오류 유발)
POSTGRES_USER=rwr_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=rwr_db

# ── Client / Vite 빌드 시 주입 ──────────────────────────────────
# 카카오맵 JavaScript API 키 (https://developers.kakao.com)
# 키가 없으면 빈 값으로 두면 됩니다 (지도 기능만 비활성)
VITE_KAKAO_MAP_KEY=
